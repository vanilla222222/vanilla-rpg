          },
          "combat": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,
            "heavyMelee": {
              "$className": "Folder",
              "$ignoreUnknownInstances": true
            },
            "lightMelee": {
              "$className": "Folder",
              "$ignoreUnknownInstances": true
            },
            "magic": {
              "$className": "Folder",
              "$ignoreUnknownInstances": true
            },
            "ranged": {
              "$className": "Folder",
              "$ignoreUnknownInstances": true
            }
